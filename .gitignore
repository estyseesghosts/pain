# Cargo build output
/target/

# Zig build and dependency caches inside the vendored snapshot
/vendor/ghostty-vt/.zig-cache/
/vendor/ghostty-vt/zig-cache/
/vendor/ghostty-vt/zig-out/
/vendor/ghostty-vt/zig-pkg/

# Release binaries are build artifacts; the source and build commands are the
# reproducible deliverable.
/pain-release.exe
*.exe

# The pinned, MIT-licensed OpenConsole host is a redistributable payload that
# must ship beside pain.exe for Kitty APC forwarding. Keep this one exception;
# other .exe files remain build artifacts.
!/windows/conpty/x64/OpenConsole.exe

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
